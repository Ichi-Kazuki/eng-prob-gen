{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/reading-generator-model-v0.2.2.schema.json",
  "title": "Reading v0.2.2 Generator grouped semantic model output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "section",
    "title",
    "passage",
    "detail_questions",
    "vocabulary_in_context_questions",
    "inference_questions",
    "main_idea_questions",
    "reference_questions"
  ],
  "$defs": {
    "questionSubtype": {
      "type": "string",
      "enum": ["DIRECT_FACTUAL_DETAIL", "PARAPHRASED_FACTUAL_DETAIL", "NEGATIVE_EXCEPT_DETAIL", "LOCAL_INFERENCE", "CROSS_IDEA_INFERENCE", "RHETORICAL_PURPOSE", "VOCABULARY_CONTEXT_MEANING", "PASSAGE_MAIN_IDEA", "ANTECEDENT_REFERENCE"]
    },
    "distractorMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["A", "B", "C", "D"],
      "properties": {
        "A": {"$ref": "#/$defs/distractorEntry"},
        "B": {"$ref": "#/$defs/distractorEntry"},
        "C": {"$ref": "#/$defs/distractorEntry"},
        "D": {"$ref": "#/$defs/distractorEntry"}
      }
    },
    "distractorEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category", "rationale"],
      "properties": {
        "category": {"enum": ["CORRECT_OPTION", "TEXT_TRUE_BUT_NOT_ANSWER", "WRONG_REFERENT", "SCOPE_SHIFT", "CAUSE_EFFECT_REVERSAL", "OVERGENERALIZATION", "UNDERGENERALIZATION", "LEXICAL_SENSE_TRAP", "UNSUPPORTED_INFERENCE", "NEARBY_DETAIL_CONFUSION", "CONTRADICTED_BY_PASSAGE"]},
        "rationale": {"type": "string", "minLength": 3, "maxLength": 300}
      }
    }
  },
  "properties": {
    "schema_version": {"const": "reading-generator-v0.2"},
    "section": {"const": "READING_COMPREHENSION"},
    "title": {"type": "string", "minLength": 3, "maxLength": 160},
    "passage": {"type": "string", "minLength": 100},
    "detail_questions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["question_type", "subtype", "stem", "choices", "correct_answer", "evidence", "distractor_metadata"],
        "properties": {
          "question_type": {"const": "DETAIL"},
          "subtype": {"$ref": "#/$defs/questionSubtype"},
          "distractor_metadata": {"$ref": "#/$defs/distractorMetadata"},
          "target_text": {"type": "string", "minLength": 1, "maxLength": 120},
          "target_line": {"type": "integer", "minimum": 1},
          "stem": {"type": "string", "minLength": 8, "maxLength": 400},
          "choices": {
            "type": "object",
            "additionalProperties": false,
            "required": ["A", "B", "C", "D"],
            "properties": {
              "A": {"type": "string", "minLength": 1, "maxLength": 300},
              "B": {"type": "string", "minLength": 1, "maxLength": 300},
              "C": {"type": "string", "minLength": 1, "maxLength": 300},
              "D": {"type": "string", "minLength": 1, "maxLength": 300}
            }
          },
          "correct_answer": {"enum": ["A", "B", "C", "D"]},
          "evidence": {
            "type": "object",
            "additionalProperties": false,
            "required": ["paragraph", "anchor", "rationale"],
            "properties": {
              "paragraph": {"type": "integer", "minimum": 1, "maximum": 8},
              "anchor": {"type": "string", "minLength": 3, "maxLength": 240},
              "rationale": {"type": "string", "minLength": 8, "maxLength": 600}
            }
          }
        }
      }
    },
    "vocabulary_in_context_questions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["question_type", "subtype", "stem", "choices", "correct_answer", "evidence", "distractor_metadata"],
        "properties": {
          "question_type": {"const": "VOCABULARY_IN_CONTEXT"},
          "subtype": {"$ref": "#/$defs/questionSubtype"},
          "distractor_metadata": {"$ref": "#/$defs/distractorMetadata"},
          "target_text": {"type": "string", "minLength": 1, "maxLength": 120},
          "target_line": {"type": "integer", "minimum": 1},
          "stem": {"type": "string", "minLength": 8, "maxLength": 400},
          "choices": {
            "type": "object",
            "additionalProperties": false,
            "required": ["A", "B", "C", "D"],
            "properties": {
              "A": {"type": "string", "minLength": 1, "maxLength": 300},
              "B": {"type": "string", "minLength": 1, "maxLength": 300},
              "C": {"type": "string", "minLength": 1, "maxLength": 300},
              "D": {"type": "string", "minLength": 1, "maxLength": 300}
            }
          },
          "correct_answer": {"enum": ["A", "B", "C", "D"]},
          "evidence": {
            "type": "object",
            "additionalProperties": false,
            "required": ["paragraph", "anchor", "rationale"],
            "properties": {
              "paragraph": {"type": "integer", "minimum": 1, "maximum": 8},
              "anchor": {"type": "string", "minLength": 3, "maxLength": 240},
              "rationale": {"type": "string", "minLength": 8, "maxLength": 600}
            }
          }
        }
      }
    },
    "inference_questions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["question_type", "subtype", "stem", "choices", "correct_answer", "evidence", "distractor_metadata"],
        "properties": {
          "question_type": {"const": "INFERENCE"},
          "subtype": {"$ref": "#/$defs/questionSubtype"},
          "distractor_metadata": {"$ref": "#/$defs/distractorMetadata"},
          "target_text": {"type": "string", "minLength": 1, "maxLength": 120},
          "target_line": {"type": "integer", "minimum": 1},
          "stem": {"type": "string", "minLength": 8, "maxLength": 400},
          "choices": {
            "type": "object",
            "additionalProperties": false,
            "required": ["A", "B", "C", "D"],
            "properties": {
              "A": {"type": "string", "minLength": 1, "maxLength": 300},
              "B": {"type": "string", "minLength": 1, "maxLength": 300},
              "C": {"type": "string", "minLength": 1, "maxLength": 300},
              "D": {"type": "string", "minLength": 1, "maxLength": 300}
            }
          },
          "correct_answer": {"enum": ["A", "B", "C", "D"]},
          "evidence": {
            "type": "object",
            "additionalProperties": false,
            "required": ["paragraph", "anchor", "rationale"],
            "properties": {
              "paragraph": {"type": "integer", "minimum": 1, "maximum": 8},
              "anchor": {"type": "string", "minLength": 3, "maxLength": 240},
              "rationale": {"type": "string", "minLength": 8, "maxLength": 600}
            }
          }
        }
      }
    },
    "main_idea_questions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["question_type", "subtype", "stem", "choices", "correct_answer", "evidence", "distractor_metadata"],
        "properties": {
          "question_type": {"const": "MAIN_IDEA"},
          "subtype": {"$ref": "#/$defs/questionSubtype"},
          "distractor_metadata": {"$ref": "#/$defs/distractorMetadata"},
          "target_text": {"type": "string", "minLength": 1, "maxLength": 120},
          "target_line": {"type": "integer", "minimum": 1},
          "stem": {"type": "string", "minLength": 8, "maxLength": 400},
          "choices": {
            "type": "object",
            "additionalProperties": false,
            "required": ["A", "B", "C", "D"],
            "properties": {
              "A": {"type": "string", "minLength": 1, "maxLength": 300},
              "B": {"type": "string", "minLength": 1, "maxLength": 300},
              "C": {"type": "string", "minLength": 1, "maxLength": 300},
              "D": {"type": "string", "minLength": 1, "maxLength": 300}
            }
          },
          "correct_answer": {"enum": ["A", "B", "C", "D"]},
          "evidence": {
            "type": "object",
            "additionalProperties": false,
            "required": ["paragraph", "anchor", "rationale"],
            "properties": {
              "paragraph": {"type": "integer", "minimum": 1, "maximum": 8},
              "anchor": {"type": "string", "minLength": 3, "maxLength": 240},
              "rationale": {"type": "string", "minLength": 8, "maxLength": 600}
            }
          }
        }
      }
    },
    "reference_questions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["question_type", "subtype", "stem", "choices", "correct_answer", "evidence", "distractor_metadata"],
        "properties": {
          "question_type": {"const": "REFERENCE"},
          "subtype": {"$ref": "#/$defs/questionSubtype"},
          "distractor_metadata": {"$ref": "#/$defs/distractorMetadata"},
          "target_text": {"type": "string", "minLength": 1, "maxLength": 120},
          "target_line": {"type": "integer", "minimum": 1},
          "stem": {"type": "string", "minLength": 8, "maxLength": 400},
          "choices": {
            "type": "object",
            "additionalProperties": false,
            "required": ["A", "B", "C", "D"],
            "properties": {
              "A": {"type": "string", "minLength": 1, "maxLength": 300},
              "B": {"type": "string", "minLength": 1, "maxLength": 300},
              "C": {"type": "string", "minLength": 1, "maxLength": 300},
              "D": {"type": "string", "minLength": 1, "maxLength": 300}
            }
          },
          "correct_answer": {"enum": ["A", "B", "C", "D"]},
          "evidence": {
            "type": "object",
            "additionalProperties": false,
            "required": ["paragraph", "anchor", "rationale"],
            "properties": {
              "paragraph": {"type": "integer", "minimum": 1, "maximum": 8},
              "anchor": {"type": "string", "minLength": 3, "maxLength": 240},
              "rationale": {"type": "string", "minLength": 8, "maxLength": 600}
            }
          }
        }
      }
    }
  }
}
