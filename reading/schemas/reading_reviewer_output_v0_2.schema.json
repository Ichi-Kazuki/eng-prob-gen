{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/reading-reviewer-output-v0.2.schema.json",
  "title": "Reading v0.2 Reviewer output",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "passage_id", "section", "questions", "set_judgment", "set_comment"],
  "properties": {
    "schema_version": {"const": "reading-reviewer-v0.2"},
    "passage_id": {"type": "string", "pattern": "^rc-[a-z0-9-]+$"},
    "section": {"const": "READING_COMPREHENSION"},
    "questions": {
      "type": "array",
      "minItems": 7,
      "maxItems": 14,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["item_id", "best_answer", "unique_answer", "distractors_incorrect", "answerable", "natural_wording", "serious_defect", "comment"],
        "properties": {
          "item_id": {"type": "string", "pattern": "^rc-[a-z0-9-]+-q(?:[1-9]|1[0-4])$"},
          "best_answer": {"enum": ["A", "B", "C", "D", "AMBIGUOUS", "NONE"]},
          "unique_answer": {"type": "boolean"},
          "distractors_incorrect": {"type": "boolean"},
          "answerable": {"type": "boolean"},
          "natural_wording": {"type": "boolean"},
          "serious_defect": {"type": "boolean"},
          "comment": {"type": "string", "minLength": 1, "maxLength": 600}
        }
      }
    },
    "set_judgment": {"enum": ["PASS", "FAIL"]},
    "set_comment": {"type": "string", "minLength": 1, "maxLength": 1000}
  }
}
