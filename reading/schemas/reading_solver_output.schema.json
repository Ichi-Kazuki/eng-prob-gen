{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/reading-solver-output-v0.1.schema.json",
  "title": "Reading Solver formal output",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "passage_id", "section", "answers"],
  "properties": {
    "schema_version": {"const": "reading-solver-v0.1"},
    "passage_id": {"type": "string", "pattern": "^rc-[a-z0-9-]+$"},
    "section": {"const": "READING_COMPREHENSION"},
    "answers": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["item_id", "answer", "confidence", "reason"],
        "properties": {
          "item_id": {"type": "string", "pattern": "^rc-[a-z0-9-]+-q[1-5]$"},
          "answer": {"enum": ["A", "B", "C", "D", "AMBIGUOUS", "NONE"]},
          "confidence": {"enum": ["HIGH", "MEDIUM", "LOW"]},
          "reason": {"type": "string", "minLength": 3, "maxLength": 800}
        }
      }
    }
  }
}
