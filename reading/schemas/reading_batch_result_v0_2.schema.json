{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/reading-batch-result-v0.2.schema.json",
  "title": "Reading v0.2 batch result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "batch_id", "output_dir", "mode", "base_seed", "seed_derivation",
    "requested_passage_count", "completed_passage_count", "parallelism_requested",
    "parallelism_effective", "accept_count", "quarantine_count",
    "infrastructure_failure_count", "total_questions_generated",
    "total_live_invocation_count", "generator_invocation_count",
    "reviewer_invocation_count", "solver_invocation_count", "leakage_count",
    "synthetic_fallback_count", "elapsed_wall_clock_seconds", "passage_artifacts",
    "passage_decisions", "diagnostics"
  ],
  "properties": {
    "schema_version": {"const": "reading-batch-result-v0.2"},
    "batch_id": {"type": "string", "minLength": 1},
    "output_dir": {"type": "string", "minLength": 1},
    "mode": {"enum": ["validated", "draft"]},
    "base_seed": {"type": "integer", "minimum": 0},
    "seed_derivation": {"type": "string", "minLength": 1},
    "requested_passage_count": {"type": "integer", "minimum": 1},
    "completed_passage_count": {"type": "integer", "minimum": 0},
    "parallelism_requested": {"type": "integer", "minimum": 1},
    "parallelism_effective": {"type": "integer", "minimum": 1},
    "accept_count": {"type": "integer", "minimum": 0},
    "quarantine_count": {"type": "integer", "minimum": 0},
    "infrastructure_failure_count": {"type": "integer", "minimum": 0},
    "draft_count": {"type": "integer", "minimum": 0},
    "total_questions_generated": {"type": "integer", "minimum": 0},
    "total_live_invocation_count": {"type": "integer", "minimum": 0},
    "generator_invocation_count": {"type": "integer", "minimum": 0},
    "reviewer_invocation_count": {"type": "integer", "minimum": 0},
    "solver_invocation_count": {"type": "integer", "minimum": 0},
    "leakage_count": {"type": "integer", "minimum": 0},
    "synthetic_fallback_count": {"type": "integer", "minimum": 0},
    "elapsed_wall_clock_seconds": {"type": "number", "minimum": 0},
    "passage_artifacts": {"type": "array", "items": {"type": "object"}},
    "passage_decisions": {"type": "array", "items": {"type": "object"}},
    "diagnostics": {"type": "object"}
  }
}
