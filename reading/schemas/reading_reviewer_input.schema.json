{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/reading-reviewer-input-v0.1.schema.json",
  "title": "Blind Reading Reviewer input",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "passage_id", "section", "title", "passage", "questions"],
  "properties": {
    "schema_version": {"const": "reading-blind-input-v0.1"},
    "passage_id": {"type": "string", "pattern": "^rc-[a-z0-9-]+$"},
    "section": {"const": "READING_COMPREHENSION"},
    "title": {"type": "string", "minLength": 3},
    "passage": {"type": "string", "minLength": 100},
    "questions": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["item_id", "number", "stem", "choices"],
        "properties": {
          "item_id": {"type": "string", "pattern": "^rc-[a-z0-9-]+-q[1-5]$"},
          "number": {"type": "integer", "minimum": 1, "maximum": 5},
          "stem": {"type": "string", "minLength": 8, "maxLength": 400},
          "choices": {
            "type": "object",
            "additionalProperties": false,
            "required": ["A", "B", "C", "D"],
            "properties": {
              "A": {"type": "string", "minLength": 1, "maxLength": 300},
              "B": {"type": "string", "minLength": 1, "maxLength": 300},
              "C": {"type": "string", "minLength": 1, "maxLength": 300},
              "D": {"type": "string", "minLength": 1, "maxLength": 300}
            }
          }
        }
      }
    }
  }
}
