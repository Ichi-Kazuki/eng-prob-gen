{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/reading-result-v0.1.schema.json",
  "title": "Reading v0.1 final result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "decision", "passage_id", "section", "plan", "generator", "reviewer", "solver", "checks", "infrastructure"],
  "properties": {
    "schema_version": {"const": "reading-result-v0.1"},
    "run_id": {"type": "string", "minLength": 3},
    "decision": {"enum": ["ACCEPT", "QUARANTINE"]},
    "passage_id": {"type": "string", "pattern": "^rc-[a-z0-9-]+$"},
    "section": {"const": "READING_COMPREHENSION"},
    "plan": {"type": "object"},
    "generator": {"type": ["object", "null"]},
    "reviewer": {"type": ["object", "null"]},
    "solver": {"type": ["object", "null"]},
    "checks": {"type": "object"},
    "infrastructure": {"type": "object"}
  }
}
