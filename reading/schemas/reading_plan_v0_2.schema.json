{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/reading-plan-v0.2.schema.json",
  "title": "Reading v0.2 generation plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "plan_id", "seed", "domain", "target_words", "target_paragraphs", "question_count", "question_plan", "question_type_counts"],
  "properties": {
    "schema_version": {"const": "reading-plan-v0.2"},
    "plan_id": {"type": "string", "pattern": "^rp-[a-z0-9-]+$"},
    "seed": {"type": "integer", "minimum": 0},
    "domain": {"enum": ["biology", "geology", "astronomy", "anthropology", "history", "ecology", "technology", "earth science"]},
    "target_words": {"type": "integer", "minimum": 260, "maximum": 340},
    "target_paragraphs": {"const": 4},
    "question_count": {"type": "integer", "enum": [7, 8, 9, 10, 11, 12, 14]},
    "question_plan": {
      "type": "array",
      "minItems": 7,
      "maxItems": 14,
      "items": {"enum": ["DETAIL", "VOCABULARY_IN_CONTEXT", "INFERENCE", "MAIN_IDEA", "REFERENCE"]}
    },
    "question_type_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["DETAIL", "VOCABULARY_IN_CONTEXT", "INFERENCE", "MAIN_IDEA", "REFERENCE"],
      "properties": {
        "DETAIL": {"type": "integer", "minimum": 0},
        "VOCABULARY_IN_CONTEXT": {"type": "integer", "minimum": 0},
        "INFERENCE": {"type": "integer", "minimum": 0},
        "MAIN_IDEA": {"type": "integer", "minimum": 0},
        "REFERENCE": {"type": "integer", "minimum": 0}
      }
    }
  }
}
