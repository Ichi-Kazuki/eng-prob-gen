{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/reading-draft-result-v0.2.schema.json",
  "title": "Reading v0.2 unvalidated draft result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "decision", "draft_status", "production_eligible", "passage_id", "section", "plan", "generator", "reviewer", "solver", "checks", "infrastructure"],
  "properties": {
    "schema_version": {"const": "reading-draft-result-v0.2"},
    "run_id": {"type": "string", "minLength": 1},
    "decision": {"const": "UNVALIDATED_DRAFT"},
    "draft_status": {"enum": ["VALIDATED_SHAPE", "QUARANTINE", "INFRASTRUCTURE_FAILURE"]},
    "production_eligible": {"const": false},
    "passage_id": {"type": "string", "pattern": "^rc-[a-z0-9-]+$"},
    "section": {"const": "READING_COMPREHENSION"},
    "plan": {"type": "object"},
    "generator": {"type": ["object", "null"]},
    "reviewer": {"const": null},
    "solver": {"const": null},
    "checks": {"type": "object"},
    "diagnostics": {"type": "object"},
    "infrastructure": {
      "type": "object",
      "required": ["live_invocations", "provider", "runtime_failures", "synthetic_fallback"],
      "properties": {
        "live_invocations": {"type": "integer", "minimum": 0},
        "provider": {"type": "string"},
        "runtime_failures": {"type": "array"},
        "synthetic_fallback": {"const": false},
        "elapsed_seconds": {"type": "number", "minimum": 0},
        "invocation_counts": {"type": "object"}
      }
    }
  }
}
