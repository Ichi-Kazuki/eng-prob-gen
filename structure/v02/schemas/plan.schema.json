{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "structure-plan-v0.2.schema.json",
  "title": "Structure v0.2 planner output",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "plan_id", "version", "seed", "question_count", "items"],
  "properties": {
    "schema_version": {"const": "structure-plan-v0.2"},
    "plan_id": {"type": "string", "minLength": 1},
    "version": {"const": "v0.2"},
    "seed": {"type": "integer", "minimum": 0},
    "question_count": {"const": 15},
    "items": {
      "type": "array",
      "minItems": 15,
      "maxItems": 15,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["item_id", "order", "section", "primary_target", "difficulty", "clause_count", "sentence_length_bin", "target_word_count"],
        "properties": {
          "item_id": {"type": "string", "minLength": 1},
          "order": {"type": "integer", "minimum": 1, "maximum": 15},
          "section": {"const": "Structure"},
          "primary_target": {"type": "string", "minLength": 1},
          "difficulty": {"enum": ["EASY", "MEDIUM", "HARD"]},
          "clause_count": {"enum": [1, 2, 3, 4]},
          "sentence_length_bin": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "minimum", "maximum", "weight"],
            "properties": {
              "label": {"type": "string", "minLength": 1},
              "minimum": {"type": "integer", "minimum": 10},
              "maximum": {"type": "integer", "maximum": 27},
              "weight": {"type": "integer", "minimum": 1}
            }
          },
          "target_word_count": {"type": "integer", "minimum": 10, "maximum": 27}
        }
      }
    }
  }
}
