{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "structure-reviewer-input-v0.2.schema.json",
  "title": "Structure v0.2 blind Reviewer input",
  "type": "object",
  "additionalProperties": false,
  "required": ["items"],
  "properties": {
    "items": {
      "type": "array",
      "minItems": 15,
      "maxItems": 15,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["item_id", "section", "stem", "candidate_options"],
        "properties": {
          "item_id": {"type": "string", "minLength": 1},
          "section": {"const": "Structure"},
          "stem": {"type": "string", "minLength": 1},
          "candidate_options": {
            "type": "array",
            "minItems": 7,
            "maxItems": 7,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  }
}
