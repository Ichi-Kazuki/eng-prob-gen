{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "structure-result-v0.1.schema.json",
  "title": "Structure v0.1 final run result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "version", "run_id", "seed", "decision", "question_count", "live_invocation_count", "deterministic_hard_failure_count", "reviewer_solver_agreement", "reviewer_ambiguous_none_count", "solver_ambiguous_none_count", "final_answer_position_distribution", "item_results", "checks", "infrastructure", "artifact_hashes", "output_dir"],
  "properties": {
    "schema_version": {"const": "structure-result-v0.1"},
    "version": {"const": "v0.1"},
    "run_id": {"type": "string", "minLength": 1},
    "seed": {"type": "integer", "minimum": 0},
    "decision": {"enum": ["ACCEPT", "QUARANTINE"]},
    "question_count": {"const": 15},
    "live_invocation_count": {"type": "integer", "minimum": 0},
    "deterministic_hard_failure_count": {"type": "integer", "minimum": 0},
    "reviewer_solver_agreement": {"type": "integer", "minimum": 0, "maximum": 15},
    "reviewer_ambiguous_none_count": {"type": "integer", "minimum": 0},
    "solver_ambiguous_none_count": {"type": "integer", "minimum": 0},
    "final_answer_position_distribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["A", "B", "C", "D"],
      "properties": {
        "A": {"type": "integer", "minimum": 0},
        "B": {"type": "integer", "minimum": 0},
        "C": {"type": "integer", "minimum": 0},
        "D": {"type": "integer", "minimum": 0}
      }
    },
    "item_results": {
      "type": "array",
      "minItems": 15,
      "maxItems": 15,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["item_id", "accepted", "rejection_reasons"],
        "properties": {
          "item_id": {"type": "string", "minLength": 1},
          "accepted": {"type": "boolean"},
          "rejection_reasons": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "checks": {"type": "object"},
    "infrastructure": {"type": "object"},
    "artifact_hashes": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}},
    "output_dir": {"type": "string", "minLength": 1}
  }
}
