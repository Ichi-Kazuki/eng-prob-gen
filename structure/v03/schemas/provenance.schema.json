{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "structure-provenance-v0.3.schema.json",
  "title": "Structure v0.3 provenance",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "version",
    "run_id",
    "seed",
    "provider",
    "model",
    "invocations",
    "invocation_ids",
    "invocation_count",
    "logical_invocation_counts",
    "deterministic_validation",
    "generator_shards",
    "candidate_selection",
    "answer_position_permutation",
    "blind_inputs",
    "reviewer_canonicalization",
    "solver_canonicalization",
    "solver_key_check",
    "leakage",
    "fallback",
    "runtime_failures",
    "artifact_hashes"
  ],
  "properties": {
    "schema_version": {"const": "structure-provenance-v0.3"},
    "version": {"const": "v0.3"},
    "run_id": {"type": "string", "minLength": 1},
    "seed": {"type": "integer", "minimum": 0},
    "provider": {"type": "string"},
    "model": {"type": "string"},
    "invocations": {"type": "array"},
    "invocation_ids": {"type": "array", "items": {"type": "string"}},
    "invocation_count": {"type": "integer", "minimum": 0},
    "logical_invocation_counts": {
      "type": "object",
      "additionalProperties": false,
      "description": "The clean successful path is generator_shard_1=1, generator_shard_2=1, generator_shard_3=1, reviewer=1, solver=1. This schema does not force those values so early-failure runs remain representable. Deliberately no Repair/Revision/Regeneration keys and no generator aggregate key.",
      "required": ["generator_shard_1", "generator_shard_2", "generator_shard_3", "reviewer", "solver"],
      "properties": {
        "generator_shard_1": {"type": "integer", "minimum": 0, "maximum": 1},
        "generator_shard_2": {"type": "integer", "minimum": 0, "maximum": 1},
        "generator_shard_3": {"type": "integer", "minimum": 0, "maximum": 1},
        "reviewer": {"type": "integer", "minimum": 0, "maximum": 1},
        "solver": {"type": "integer", "minimum": 0, "maximum": 1}
      }
    },
    "deterministic_validation": {"type": "object"},
    "generator_shards": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "completed_calls",
        "contract_pass_count",
        "all_three_contracts_passed",
        "merged_candidate_batch_constructed",
        "items"
      ],
      "properties": {
        "completed_calls": {"type": "integer", "minimum": 0, "maximum": 3},
        "contract_pass_count": {"type": "integer", "minimum": 0, "maximum": 3},
        "all_three_contracts_passed": {"type": "boolean"},
        "merged_candidate_batch_constructed": {"type": "boolean"},
        "items": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["shard", "stage", "raw_artifact", "validated_artifact", "invoked", "contract_passed"],
            "properties": {
              "shard": {"enum": [1, 2, 3]},
              "stage": {"type": "string", "minLength": 1},
              "raw_artifact": {"type": "string", "minLength": 1},
              "validated_artifact": {"type": "string", "minLength": 1},
              "invoked": {"type": "boolean"},
              "contract_passed": {"type": "boolean"}
            }
          }
        }
      }
    },
    "candidate_selection": {"type": "object"},
    "answer_position_permutation": {"type": ["object", "null"]},
    "blind_inputs": {"type": "object"},
    "reviewer_canonicalization": {"type": "object"},
    "solver_canonicalization": {"type": "object"},
    "solver_key_check": {
      "type": "object",
      "description": "Records the final Solver-vs-assembled-key check. The v0.3 Reviewer does not choose a final answer, so provenance instead records candidate selection and this final Solver-vs-key check, not a reviewer-vs-solver agreement concept."
    },
    "leakage": {"type": "object"},
    "fallback": {"type": "object"},
    "runtime_failures": {"type": "array"},
    "artifact_hashes": {
      "type": "object",
      "additionalProperties": false,
      "description": "Exactly the sixteen non-circular hashed artifacts. result.json and provenance.json are deliberately excluded to avoid circular provenance.",
      "required": [
        "plan.json",
        "generator_shard_1_raw.json",
        "generator_shard_1_candidates.json",
        "generator_shard_2_raw.json",
        "generator_shard_2_candidates.json",
        "generator_shard_3_raw.json",
        "generator_shard_3_candidates.json",
        "generator_candidates.json",
        "reviewer_input.json",
        "reviewer.json",
        "candidate_selection.json",
        "generator_final.json",
        "permutation.json",
        "generator.json",
        "solver_input.json",
        "solver.json"
      ],
      "properties": {
        "plan.json": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "generator_shard_1_raw.json": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "generator_shard_1_candidates.json": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "generator_shard_2_raw.json": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "generator_shard_2_candidates.json": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "generator_shard_3_raw.json": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "generator_shard_3_candidates.json": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "generator_candidates.json": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$",
          "description": "Hash of the deterministic merged 15-item candidate batch, only after all three shards and merged validation pass; otherwise the hash of JSON null."
        },
        "reviewer_input.json": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "reviewer.json": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "candidate_selection.json": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "generator_final.json": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "permutation.json": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "generator.json": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$",
          "description": "Hash of the FINAL PERMUTED four-option Generator batch used to derive Solver input. Not the seven-candidate Generator response; that is generator_candidates.json."
        },
        "solver_input.json": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "solver.json": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    }
  }
}
