{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "provenance.schema.json",
  "title": "TOEFL ITP Orchestrator - per-item provenance record",
  "description": "The Draft 2020-12 runtime contract for one candidate provenance record, combining a short summary with the accepted_item / qa_audit split.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "item_id", "concept_id", "section", "state", "state_history",
    "generation_attempt", "revision_count", "validation_retry_counts",
    "system_failure_retry_counts", "generator", "reviewer", "solver",
    "consensus", "batch_slot", "versions", "accepted_item", "qa_audit"
  ],
  "properties": {
    "item_id": { "type": "string" },
    "concept_id": { "type": "string" },
    "section": { "enum": ["Structure", "Written Expression"] },
    "state": { "enum": ["GENERATED", "GENERATION_FAILED", "VALIDATION_FAILED", "REVIEWING", "REVISE_REQUIRED", "REJECTED", "SOLVING", "ACCEPTED", "MANUAL_REVIEW", "DISCARDED"] },
    "state_history": { "type": "array", "items": { "enum": ["GENERATED", "GENERATION_FAILED", "VALIDATION_FAILED", "REVIEWING", "REVISE_REQUIRED", "REJECTED", "SOLVING", "ACCEPTED", "MANUAL_REVIEW", "DISCARDED"] } },
    "generation_attempt": { "type": "integer", "minimum": 1 },
    "revision_count": { "type": "integer", "minimum": 0 },
    "validation_retry_counts": { "$ref": "#/$defs/stage_retry_counts" },
    "system_failure_retry_counts": { "$ref": "#/$defs/stage_retry_counts" },
    "generator": {
      "type": ["object", "null"],
      "properties": { "answer": { "enum": ["A", "B", "C", "D"] } }
    },
    "reviewer": {
      "type": ["object", "null"],
      "properties": {
        "verdict": { "enum": ["PASS", "REVISE", "REJECT"] },
        "independent_answer": { "type": "string" },
        "difficulty": { "enum": ["EASY", "MEDIUM", "HARD"] }
      }
    },
    "solver": {
      "type": ["object", "null"],
      "properties": {
        "answer": { "type": "string" },
        "confidence": { "enum": ["HIGH", "MEDIUM", "LOW"] }
      }
    },
    "consensus": {
      "type": "boolean",
      "description": "True iff state == ACCEPTED. For the full failed_conditions/disagreement_reasons detail, see qa_audit.consensus."
    },
    "batch_slot": {
      "type": ["object", "null"],
      "description": "Slot requirements (primary_target/difficulty/correct_answer_position/vocabulary_domain[/tested_error_type/error_scope]) to hand to a fresh Generator call if this candidate is discarded or rejected (spec section 14)."
    },
    "versions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "spec_version", "taxonomy_version", "generator_version",
        "reviewer_version", "solver_version", "orchestrator_version",
        "config_version", "generator_validator_version",
        "reviewer_validator_version", "solver_validator_version",
        "solver_blinding_version", "schema_runtime_version", "generator_schema_version",
        "reviewer_schema_version", "solver_schema_version",
        "provenance_schema_version"
      ],
      "properties": {
        "spec_version": { "type": "string" },
        "taxonomy_version": { "type": "string" },
        "generator_version": { "type": "string" },
        "reviewer_version": { "type": "string" },
        "solver_version": { "type": "string" },
        "orchestrator_version": { "type": "string" },
        "config_version": { "type": "string" },
        "generator_validator_version": { "type": "string" },
        "reviewer_validator_version": { "type": "string" },
        "solver_validator_version": { "type": "string" },
        "solver_blinding_version": { "type": "string" },
        "schema_runtime_version": { "type": "string" },
        "generator_schema_version": { "type": "string" },
        "reviewer_schema_version": { "type": "string" },
        "solver_schema_version": { "type": "string" },
        "provenance_schema_version": { "type": "string" }
      }
    },
    "accepted_item": {
      "description": "See accepted_item.schema.json. Null unless state == ACCEPTED.",
      "type": ["object", "null"]
    },
    "qa_audit": {
      "description": "See qa_audit.schema.json. Always present.",
      "type": "object"
    },
    "validation_trace": {
      "type": "object",
      "description": "Validation-batch-only history for the fixed initial cohort."
    }
  },
  "$defs": {
    "stage_retry_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generator", "reviewer", "solver"],
      "properties": {
        "generator": { "type": "integer", "minimum": 0 },
        "reviewer": { "type": "integer", "minimum": 0 },
        "solver": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
