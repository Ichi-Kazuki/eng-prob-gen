{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "provenance.schema.json",
  "title": "TOEFL ITP Orchestrator - per-item provenance record",
  "description": "Runtime Draft 2020-12 contract for the record emitted by orchestrator.build_provenance_record(). The accepted_item and qa_audit members are validated against their own canonical contracts at finalization.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "item_id", "concept_id", "section", "state", "state_history",
    "generation_attempt", "revision_count", "generator", "reviewer", "solver",
    "consensus", "batch_slot", "versions", "accepted_item", "qa_audit"
  ],
  "properties": {
    "item_id": { "type": "string" },
    "concept_id": { "type": "string" },
    "section": { "enum": ["Structure", "Written Expression"] },
    "state": { "type": "string" },
    "state_history": { "type": "array", "items": { "type": "string" } },
    "generation_attempt": { "type": "integer", "minimum": 1 },
    "revision_count": { "type": "integer", "minimum": 0 },
    "retry_summary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "system": { "$ref": "#/$defs/retry_counts" },
        "validation": { "$ref": "#/$defs/retry_counts" }
      },
      "required": ["system", "validation"]
    },
    "generator": {
      "type": ["object", "null"],
      "properties": { "answer": { "enum": ["A", "B", "C", "D"] } }
    },
    "reviewer": {
      "type": ["object", "null"],
      "properties": {
        "verdict": { "enum": ["PASS", "REVISE", "REJECT"] },
        "independent_answer": { "type": "string" },
        "difficulty": { "enum": ["EASY", "MEDIUM", "HARD"] }
      }
    },
    "solver": {
      "type": ["object", "null"],
      "properties": {
        "answer": { "type": "string" },
        "confidence": { "enum": ["HIGH", "MEDIUM", "LOW"] }
      }
    },
    "consensus": {
      "type": "boolean",
      "description": "True iff state == ACCEPTED. For the full failed_conditions/disagreement_reasons detail, see qa_audit.consensus."
    },
    "batch_slot": {
      "type": ["object", "null"],
      "description": "Slot requirements (primary_target/difficulty/correct_answer_position/vocabulary_domain[/tested_error_type/error_scope]) to hand to a fresh Generator call if this candidate is discarded or rejected (spec section 14)."
    },
    "versions": {
      "type": "object",
      "properties": {
        "spec_version": { "type": "string" },
        "taxonomy_version": { "type": "string" },
        "generator_version": { "type": "string" },
        "reviewer_version": { "type": "string" },
        "solver_version": { "type": "string" }
      }
    },
    "accepted_item": {
      "description": "See accepted_item.schema.json. Null unless state == ACCEPTED.",
      "type": ["object", "null"]
    },
    "qa_audit": {
      "description": "See qa_audit.schema.json. Always present.",
      "type": "object"
    },
    "validation_trace": {
      "type": "object",
      "additionalProperties": true,
      "description": "Validation-batch-only replay trace."
    },
    "candidate_provenance": {
      "type": "object",
      "additionalProperties": true,
      "description": "Pilot artifact trace retained for the original candidate and any replacement/revision context."
    },
    "failure_classification": {
      "type": "object",
      "additionalProperties": true,
      "description": "Pilot artifact failure classification details."
    }
  },
  "$defs": {
    "retry_counts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "generator": { "type": "integer", "minimum": 0 },
        "reviewer": { "type": "integer", "minimum": 0 },
        "solver": { "type": "integer", "minimum": 0 }
      },
      "required": ["generator", "reviewer", "solver"]
    }
  }
}
