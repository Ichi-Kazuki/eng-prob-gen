{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "reviewer_input_batch.schema.json",
  "title": "Canonical blinded Reviewer input batch",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact_version", "state_fingerprint", "items", "input_sha256"],
  "properties": {
    "artifact_version": {"const": 1},
    "state_fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["item_id", "section"],
        "properties": {
          "item_id": {"type": "string", "minLength": 1},
          "section": {"enum": ["Structure", "Written Expression"]},
          "stem": {"type": "string", "minLength": 1},
          "sentence": {"type": "string", "minLength": 1},
          "options": {"type": "object", "additionalProperties": {"type": "string"}},
          "marked_parts": {"type": "object", "additionalProperties": {"type": "string"}}
        },
        "oneOf": [
          {
            "required": ["stem", "options"],
            "properties": {"section": {"const": "Structure"}}
          },
          {
            "required": ["sentence", "marked_parts"],
            "properties": {"section": {"const": "Written Expression"}}
          }
        ]
      }
    },
    "input_sha256": {
      "type": "object",
      "additionalProperties": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
    }
  }
}
