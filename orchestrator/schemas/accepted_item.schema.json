{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "accepted_item.schema.json",
  "title": "TOEFL ITP Orchestrator - public accepted item (runtime contract)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "item_id", "section", "difficulty", "vocabulary_domain",
    "spec_version", "taxonomy_version", "correct_answer", "explanation", "taxonomy"
  ],
  "properties": {
    "item_id": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "section": { "enum": ["Structure", "Written Expression"] },
    "difficulty": { "enum": ["EASY", "MEDIUM", "HARD"] },
    "vocabulary_domain": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "spec_version": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "taxonomy_version": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "stem": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "options": {
      "type": "object", "additionalProperties": false,
      "required": ["A", "B", "C", "D"],
      "properties": {
        "A": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "B": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "C": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "D": { "type": "string", "minLength": 1, "pattern": "\\S" }
      }
    },
    "sentence": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "marked_parts": {
      "type": "object", "additionalProperties": false,
      "required": ["A", "B", "C", "D"],
      "properties": {
        "A": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "B": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "C": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "D": { "type": "string", "minLength": 1, "pattern": "\\S" }
      }
    },
    "correct_answer": { "enum": ["A", "B", "C", "D"] },
    "explanation": {
      "type": "object", "additionalProperties": false,
      "required": ["answer_explanation"],
      "properties": {
        "answer_explanation": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "distractor_rationales": {
          "type": "object", "additionalProperties": false,
          "required": ["A", "B", "C", "D"],
          "properties": {
            "A": { "type": "string", "minLength": 1, "pattern": "\\S" },
            "B": { "type": "string", "minLength": 1, "pattern": "\\S" },
            "C": { "type": "string", "minLength": 1, "pattern": "\\S" },
            "D": { "type": "string", "minLength": 1, "pattern": "\\S" }
          }
        },
        "minimal_correction": { "type": "string", "minLength": 1, "pattern": "\\S" }
      }
    },
    "taxonomy": {
      "type": "object", "additionalProperties": false,
      "required": ["primary_target", "subtype", "secondary_features"],
      "properties": {
        "primary_target": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "subtype": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "secondary_features": { "type": "array", "items": { "type": "string", "minLength": 1, "pattern": "\\S" } },
        "tested_error_type": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "error_scope": { "type": "string", "minLength": 1, "pattern": "\\S" }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "section": { "const": "Structure" } }, "required": ["section"] },
      "then": {
        "required": ["stem", "options"],
        "properties": {
          "explanation": { "required": ["answer_explanation", "distractor_rationales"] }
        },
        "not": { "anyOf": [{ "required": ["sentence"] }, { "required": ["marked_parts"] }] }
      }
    },
    {
      "if": { "properties": { "section": { "const": "Written Expression" } }, "required": ["section"] },
      "then": {
        "required": ["sentence", "marked_parts"],
        "properties": {
          "explanation": { "required": ["answer_explanation", "minimal_correction"] },
          "taxonomy": { "required": ["tested_error_type", "error_scope"] }
        },
        "not": { "anyOf": [{ "required": ["stem"] }, { "required": ["options"] }] }
      }
    }
  ]
}
