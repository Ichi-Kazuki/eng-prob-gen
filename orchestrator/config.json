{
  "pipeline_version": "1.0.0",
  "retry_policy": {
    "max_revision_cycles": 2,
    "max_generation_validation_retries": 2,
    "max_system_failure_retries": 3,
    "stage_failure_policy": "live_agent_integration_only",
    "replay_driver_behavior": "stage failures are surfaced; rerun with corrected external output"
  },
  "auto_accept": {
    "allowed_solver_confidence": ["HIGH", "MEDIUM"],
    "block_source_similarity_risk": ["HIGH"]
  },
  "paths": {
    "spec_json": "specs/toefl_itp_grammar_spec.json",
    "generator_agent_md": ".claude/agents/toefl-itp-grammar-generator.md",
    "reviewer_agent_md": ".claude/agents/toefl-itp-grammar-reviewer.md",
    "solver_agent_md": ".claude/agents/toefl-itp-grammar-solver.md",
    "generator_validate_script": "agents/toefl_itp_grammar_generator/scripts/validate_output.py",
    "reviewer_validate_script": "agents/toefl_itp_grammar_reviewer/scripts/validate_output.py",
    "solver_validate_script": "agents/toefl_itp_grammar_solver/scripts/validate_output.py",
    "solver_blinding_script": "agents/toefl_itp_grammar_solver/scripts/create_solver_input.py",
    "manual_review_queue": "analysis/manual_review_queue.json"
  }
}
